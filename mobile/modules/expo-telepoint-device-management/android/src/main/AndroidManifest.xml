<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    RECEIVE_SMS backs the offline SMS LOCK/UNLOCK channel. On a Device Owner
    device the app grants this to itself silently (setPermissionGrantState); the
    manifest entry alone grants nothing on a normal device.
  -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />

  <!--
    Native background command delivery. A foreground service polls the portal so
    an authorised LOCK/UNLOCK executes with the app closed. dataSync is the
    matching foreground-service type required on Android 14 (API 34).
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <!--
    Package visibility (Android 11+): without these, resolveActivity() returns
    null for the Chinese-OEM permission screens (MIUI/Funtouch/ColorOS/EMUI/
    Transsion) and the autostart + background-pop-ups buttons can never open
    their real pages. Queries grant visibility only — no permissions.
  -->
  <queries>
    <package android:name="com.miui.securitycenter" />
    <package android:name="com.vivo.permissionmanager" />
    <package android:name="com.iqoo.secure" />
    <package android:name="com.coloros.safecenter" />
    <package android:name="com.oplus.battery" />
    <package android:name="com.transsion.phonemaster" />
    <package android:name="com.huawei.systemmanager" />
  </queries>

  <!--
    Device-admin receiver for consent-based EMI device management.
    The user must explicitly activate this in the Android system dialog; the
    manifest entry alone grants nothing. android:exported=true is required so
    the OS device-admin subsystem can bind to the receiver.
  -->
  <application>
    <receiver
      android:name="com.telepoint.devicemanagement.TelepointDeviceAdminReceiver"
      android:label="@string/telepoint_device_admin_label"
      android:description="@string/telepoint_device_admin_description"
      android:permission="android.permission.BIND_DEVICE_ADMIN"
      android:exported="true">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/telepoint_device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>

    <!--
      Re-applies the EMI lock after a reboot when the account is still locked,
      so a restart cannot defeat the financing lock. Fires only on boot; the
      RECEIVE_BOOT_COMPLETED permission is declared by the app (app.json).
    -->
    <receiver
      android:name="com.telepoint.devicemanagement.TelepointBootReceiver"
      android:exported="true"
      android:directBootAware="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>

    <!--
      Offline SMS LOCK/UNLOCK. Honoured only when the sender matches the
      allowlisted admin/retailer numbers AND the message names this device's
      customer code. This is a convenience channel, NOT cryptographically
      authenticated: sender IDs can be spoofed by online gateways and the
      customer knows their own code. Protected with BROADCAST_SMS so only the
      system can deliver the broadcast.
    -->
    <receiver
      android:name="com.telepoint.devicemanagement.SmsCommandReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter android:priority="999">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>

    <!--
      SIM sentinel: SIM removal / unauthorised swap → lock (+ alert SMS on swap).
      Dormant until a baseline SIM signature is provisioned.
    -->
    <receiver
      android:name="com.telepoint.devicemanagement.SimSentinelReceiver"
      android:exported="true">
      <intent-filter android:priority="999">
        <action android:name="android.intent.action.SIM_STATE_CHANGED" />
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>

    <!--
      Native command delivery while the app is closed. Internal only; started by
      the app after login and on boot (this app is the Device Owner/DPC, so a
      foreground service may be started from BOOT_COMPLETED).
    -->
    <service
      android:name="com.telepoint.devicemanagement.TelepointCommandService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="dataSync" />

    <!--
      Owner-authorised AccessibilityService: deterrent against uninstall /
      clear-data / force-stop / factory-reset screens while the EMI is
      outstanding. Binding permission is declared here (it is NOT a runtime
      <uses-permission>). Device Owner remains the guaranteed block. Release
      disables it (LoanStateStore.isUninstallProtected == false).
    -->
    <service
      android:name="com.telepoint.devicemanagement.TelepointAccessibilityService"
      android:exported="true"
      android:label="@string/telepoint_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/telepoint_accessibility_service" />
    </service>
  </application>
</manifest>
