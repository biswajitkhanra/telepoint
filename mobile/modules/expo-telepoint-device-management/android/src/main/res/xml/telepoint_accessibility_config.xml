<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility config for TelePoint EMI uninstall protection. It observes window
  state/content changes only so it can detect the uninstall / device-admin-removal
  screens for THIS app and navigate back while the EMI is unpaid. It requests the
  minimum needed: it does not enable touch exploration or key filtering.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagRetrieveInteractiveWindows"
  android:canRetrieveWindowContent="true"
  android:notificationTimeout="200"
  android:description="@string/telepoint_accessibility_description" />
