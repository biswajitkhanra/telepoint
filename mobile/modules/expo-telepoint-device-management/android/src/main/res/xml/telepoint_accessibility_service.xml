<?xml version="1.0" encoding="utf-8"?>
<!--
  TelePoint accessibility deterrent config (owner-authorised).
  canRetrieveWindowContent is required to keyword-match the uninstall / clear-data
  / factory-reset screens. Nothing is stored. isAccessibilityTool=false marks this
  as a device-management aid, not a screen reader (Android 12+).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
  android:canRetrieveWindowContent="true"
  android:description="@string/telepoint_accessibility_description"
  android:isAccessibilityTool="false"
  android:label="@string/telepoint_accessibility_label"
  android:notificationTimeout="100" />
