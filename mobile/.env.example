# ═══════════════════════════════════════════════════════════════════════════════
# TELEPOINT MOBILE (EXPO / REACT NATIVE) — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` in the `mobile/` directory for local development.
# Configure these variables in EAS Environment Variables for EAS Cloud Builds.
# ═══════════════════════════════════════════════════════════════════════════════

# ── TELEPOINT BACKEND PORTAL URL (Critical) ───────────────────────────────────
# The full HTTP/HTTPS URL of your Next.js Telepoint web portal API.
# The mobile app uses this URL for /api/customer-login, /api/customer-app-token,
# and for the embedded Staff Portal WebView (/login).
#
# Option A — Local Physical Phone via Wi-Fi (Same Wi-Fi network):
# EXPO_PUBLIC_PORTAL_URL=http://192.168.31.29:3000
#
# Option B — Android Emulator on same machine:
# EXPO_PUBLIC_PORTAL_URL=http://10.0.2.2:3000
#
# Option C — Live Deployed Production Web Portal (Vercel / Custom domain):
EXPO_PUBLIC_PORTAL_URL=https://telepoint.vercel.app

# ── SUPABASE CREDENTIALS ──────────────────────────────────────────────────────
# Matches the Supabase project used by the backend database
EXPO_PUBLIC_SUPABASE_URL=https://tjqigwdivmcyikurpepe.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRqcWlnd2Rpdm1jeWlrdXJwZXBlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3MTUzMDAsImV4cCI6MjA5NTI5MTMwMH0.c9P4e1c1o73ZmZ_wK1uEHUK_y5a3HS04oYCKKSoJScA

