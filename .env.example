# ═══════════════════════════════════════════════════════════════════════════════
# TELEPOINT WEB PORTAL & API — ENVIRONMENT CONFIGURATION
# Copy this file to `.env.local` for local development.
# Configure these variables in Vercel Project Settings for production deployment.
# ═══════════════════════════════════════════════════════════════════════════════

# ── SUPABASE CONFIGURATION (Required) ─────────────────────────────────────────
# Found in your Supabase Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://tjqigwdivmcyikurpepe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRqcWlnd2Rpdm1jeWlrdXJwZXBlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk3MTUzMDAsImV4cCI6MjA5NTI5MTMwMH0.c9P4e1c1o73ZmZ_wK1uEHUK_y5a3HS04oYCKKSoJScA

# SUPABASE_SERVICE_ROLE_KEY: The secret service role key with admin bypass RLS.
# Required for Next.js API routes (/api/customer-login, /api/cron/emi-reminders, /api/backup)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── APPLICATION URL (Optional / Recommended) ──────────────────────────────────
# Base URL for customer receipts and external links.
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── CRON & SECURITY TOKENS (Optional) ─────────────────────────────────────────
# Secret token to protect daily automated cron routes (/api/cron/emi-reminders, /api/fines/recalc)
CRON_SECRET=telepoint-cron-secret-change-me

# Secret token for database backup endpoint (/api/backup)
BACKUP_TOKEN=telepoint-backup-token-change-me

# ── EXPO PUSH NOTIFICATION DISPATCH (Optional) ────────────────────────────────
# Personal Access Token from Expo account (https://expo.dev/settings/access-tokens)
# Used if you require authenticated push notification dispatch
EXPO_ACCESS_TOKEN=
