# ═══════════════════════════════════════════════════════════════════════════════
# TELEPOINT WEB PORTAL (Next.js) — ENVIRONMENT
# Local dev: copy to `.env.local`. Production: set these in Vercel → Settings →
# Environment Variables. NEXT_PUBLIC_* are exposed to the browser; the rest are
# server-only secrets (never prefix a secret with NEXT_PUBLIC_).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Supabase (from the new project → Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<your service_role key — SECRET, server only>

# ── Portal URL (used for deep links / redirects) ──────────────────────────────
NEXT_PUBLIC_APP_URL=https://<your-portal>.vercel.app

# ── Customer app auth (SECRET) ────────────────────────────────────────────────
# Signs the customer app's session token. Use a long random string (32+ chars).
# The device APIs reject customer requests whose token wasn't signed with this.
CUSTOMER_SESSION_SECRET=<random 32+ char secret>
# Require a valid signed session for customer_id lookups (recommended: true).
CUSTOMER_ID_REQUIRES_SESSION=true

# ── Device command tuning (optional) ──────────────────────────────────────────
# How long a LOCK/UNLOCK stays actionable before it expires (minutes). Default 4320 (3 days).
DEVICE_COMMAND_TTL_MINUTES=4320

# ── Protected endpoints (SECRETS, optional but recommended) ───────────────────
CRON_SECRET=<random secret for scheduled endpoints>
BACKUP_TOKEN=<random secret for the backup endpoint>
